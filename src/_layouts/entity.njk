{# Academic Credential -> Coursework #}

{% if entity == "credential" and collections.coursework %}

{% set hasCredentialCourses = false %}

{% for course in collections.coursework %}
    {% if course.data.credentials and id in course.data.credentials %}
        {% set hasCredentialCourses = true %}
    {% endif %}
{% endfor %}

{% if hasCredentialCourses %}

<h2>Coursework</h2>

<ul>
{% for course in collections.coursework %}
    {% if course.data.credentials and id in course.data.credentials %}
        <li>
            <a href="{{ course.url }}">
                {% if course.data.code %}
                    {{ course.data.code }} —
                {% endif %}
                {{ course.data.title }}
            </a>

            {% if course.data.term %}
                ({{ course.data.term }})
            {% endif %}
        </li>
    {% endif %}
{% endfor %}
</ul>

{% endif %}

{% endif %}


