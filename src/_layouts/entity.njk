---
layout: base.njk
---

<h1>{{ title }}</h1>

{% if entity %}
<p><strong>Entity:</strong> {{ entity }}</p>
{% endif %}

{% if location %}
<p><strong>Location:</strong> {{ location }}</p>
{% endif %}

{% if start or end %}
<p>
    <strong>Dates:</strong>
    {{ start }}{% if end %} – {{ end }}{% endif %}
</p>
{% endif %}

{% if code %}
<p><strong>Course Code:</strong> {{ code }}</p>
{% endif %}

{% if credits %}
<p><strong>Credits:</strong> {{ credits }}</p>
{% endif %}

{% if term %}
<p><strong>Term:</strong> {{ term }}</p>
{% endif %}

<hr>

{{ content | safe }}


{# ============================================================
   PROJECT RELATIONSHIPS
   ============================================================ #}


{# Project -> Position #}

{% if entity == "project" and position and collections.positions %}

<h2>Position</h2>

<ul>
{% for positionItem in collections.positions %}
    {% if positionItem.data.id == position %}
        <li>
            <a href="{{ positionItem.url }}">
                {{ positionItem.data.title }}
            </a>
        </li>
    {% endif %}
{% endfor %}
</ul>

{% endif %}


{# Project -> Institution #}

{% if entity == "project" and institution and collections.institutions %}

<h2>Institution</h2>

<ul>
{% for institutionItem in collections.institutions %}
    {% if institutionItem.data.id == institution %}
        <li>
            <a href="{{ institutionItem.url }}">
                {{ institutionItem.data.title }}
            </a>
        </li>
    {% endif %}
{% endfor %}
</ul>

{% endif %}


{# Project -> Competencies #}

{% if entity == "project" and competencies and collections.competencies %}

<h2>Competencies</h2>

<ul>
