---
layout: base.njk
---

<h1>{{ title }}</h1>

{% if entity %}
<p><strong>Entity:</strong> {{ entity }}</p>
{% endif %}

{% if location %}
<p><strong>Location:</strong> {{ location }}</p>
{% endif %}

{% if start or end %}
<p><strong>Dates:</strong> {{ start }}{% if end %} – {{ end }}{% endif %}</p>
{% endif %}

<hr>

{{ content | safe }}

{% if projects %}
<h2>Projects</h2>
<ul>
{% for project in projects %}
    <li>{{ project }}</li>
{% endfor %}
</ul>
{% endif %}

{% if competencies %}
<h2>Competencies</h2>
<ul>
{% for competency in competencies %}
    <li>{{ competency }}</li>
{% endfor %}
</ul>
{% endif %}

{% if software %}
<h2>Software</h2>
<ul>
{% for item in software %}
    <li>{{ item }}</li>
{% endfor %}
</ul>
{% endif %}

{% if standards %}
<h2>Standards</h2>
<ul>
{% for standard in standards %}
    <li>{{ standard }}</li>
{% endfor %}
</ul>
{% endif %}