                <a href="{{ competency.url }}">
                    {{ competency.data.title }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
{% endfor %}
</ul>

{% endif %}


{# Project -> Software #}

{% if entity == "project" and software and collections.software %}

<h2>Software & Tools</h2>

